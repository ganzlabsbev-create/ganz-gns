# Postgres, provisioned via Vercel Marketplace → Neon, connected with a
# "GANZ" custom prefix (to avoid colliding with a pre-existing env var of
# the same base name in this project).
#
# Vercel injects GANZ_DATABASE_URL automatically once connected — you
# don't need to fill this in by hand for a deployed project.
#
# For local development, run:
#   vercel env pull .env.local
# which pulls the real value down from your Vercel project.
GANZ_DATABASE_URL=
